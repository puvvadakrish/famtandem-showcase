# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Vercel Cron / jobs
CRON_SECRET=replace-with-long-random-secret
JOB_BATCH_SIZE=5

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Coverage request email sending
COVERAGE_REQUEST_TOKEN_SECRET=replace-with-long-random-secret
COVERAGE_REQUEST_SENDER=local-stub
RESEND_API_KEY=
RESEND_FROM_EMAIL="FamTandem <coverage@updates.famtandem.com>"
RESEND_REPLY_TO_EMAIL=

# Household notification emails
HOUSEHOLD_NOTIFICATION_SENDER=local-stub

# Google Calendar export
GOOGLE_CALENDAR_EXPORTER=disabled
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_SECRET=

# Future provider webhooks / SMS
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Extraction
GEMINI_API_KEY=
EXTRACTION_PROVIDER=local-stub
GEMINI_MODEL=gemini-3.5-flash

# Upload OCR / artifact text extraction
ARTIFACT_TEXT_PROVIDER=disabled
ARTIFACT_TEXT_MODEL=gemini-3.5-flash
